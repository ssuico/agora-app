---
import ThemeBoot from "../components/app/ThemeBoot.astro";
import { Toaster } from '../components/app/Toaster';
import '../styles/global.css';
interface Props {
  title?: string;
  /** Login passes this when the Discover section is rendered below the hero. */
  showDiscover?: boolean;
}
const { title = 'Agora POS', showDiscover = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <ThemeBoot />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/auth-bg-960.webp" type="image/webp" media="(max-width: 1023px)" />
    <link rel="preload" as="image" href="/auth-bg-1920.webp" type="image/webp" media="(min-width: 1024px)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-canvas text-foreground antialiased">
    <Toaster client:load />
    <a class="auth-skip" href="#auth-form">Skip to form</a>
    <main
      class:list={[
        'relative isolate flex min-h-screen items-center justify-center overflow-x-hidden px-4 pt-8 sm:px-6',
        showDiscover
          ? 'auth-main--discover'
          : 'pb-[max(2rem,env(safe-area-inset-bottom))]',
      ]}
    >
      <div class="auth-backdrop" aria-hidden="true"></div>
      <slot />
      {
        showDiscover && (
          <a href="#discover" class="auth-discover-hint">
            Discover Agora
            <svg
              class="motion-safe:animate-bounce"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </a>
        )
      }
    </main>
    <slot name="below" />
    <script>
      const hint = document.querySelector('.auth-discover-hint');
      if (hint instanceof HTMLElement) {
        const update = () => {
          const hidden = window.scrollY > window.innerHeight * 0.4;
          hint.classList.toggle('is-hidden', hidden);
          if (hidden) {
            hint.setAttribute('aria-hidden', 'true');
            hint.tabIndex = -1;
          } else {
            hint.removeAttribute('aria-hidden');
            hint.removeAttribute('tabindex');
          }
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
      }
    </script>
  </body>
</html>
