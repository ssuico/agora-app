---
import { Toaster } from '../components/app/Toaster';
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'Agora POS' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/auth-bg-960.webp" type="image/webp" media="(max-width: 1023px)" />
    <link rel="preload" as="image" href="/auth-bg-1920.webp" type="image/webp" media="(min-width: 1024px)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-canvas text-foreground antialiased">
    <Toaster client:load />
    <a class="auth-skip" href="#auth-form">Skip to form</a>
    <main class="relative isolate flex min-h-screen items-center justify-center overflow-x-hidden px-4 pt-8 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-6">
      <div class="auth-backdrop" aria-hidden="true"></div>
      <slot />
    </main>
  </body>
</html>
