---
import AuthLayout from '../../layouts/AuthLayout.astro';

interface Notice {
  label: string;
  detail: string;
}

interface Props {
  title: string;
  kicker?: string;
  headline?: string;
  lede?: string;
  notices?: Notice[];
  showMobileMark?: boolean;
}

const { title, kicker, headline, lede, notices = [], showMobileMark = true } = Astro.props;
const hasBoardContent = Boolean(kicker || headline || lede || notices.length > 0);
---

<AuthLayout title={title}>
  <div class="auth-frame">
    <section
      class:list={['auth-board', !hasBoardContent && 'auth-board--logo']}
      aria-label={hasBoardContent ? 'How this sign-in works' : undefined}
      aria-hidden={hasBoardContent ? undefined : 'true'}
    >
      {!hasBoardContent && <img class="auth-logo" src="/logo.svg" alt="" width="256" height="256" />}
      {
        hasBoardContent && (
          <>
            <div>
              {kicker && <p class="auth-kicker">{kicker}</p>}
              <p class="auth-wordmark" translate="no">Agora</p>
              {headline && <p class="auth-headline">{headline}</p>}
              {lede && <p class="auth-lede">{lede}</p>}
            </div>
            {notices.length > 0 && (
              <ul class="auth-notices">
                {notices.map((notice) => (
                  <li>
                    <p class="auth-notice-label">{notice.label}</p>
                    <p class="auth-notice-detail">{notice.detail}</p>
                  </li>
                ))}
              </ul>
            )}
          </>
        )
      }
    </section>
    <div id="auth-form" class="auth-ticket">
      {showMobileMark && <p class="auth-mobile-mark" translate="no">Agora</p>}
      <slot />
    </div>
  </div>
</AuthLayout>
