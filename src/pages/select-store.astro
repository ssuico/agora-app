---
import CustomerLayout from '../layouts/CustomerLayout.astro';
import { createApiClient } from '../lib/api';
import { Badge } from '../components/ui/badge';
import { Card, CardContent } from '../components/ui/card';
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia } from '../components/ui/empty';
import { Store as StoreIcon } from 'lucide-react';

const token = Astro.cookies.get('agora_token')?.value ?? '';
const api = createApiClient(token);

const locationId = Astro.url.searchParams.get('locationId');

if (!locationId) {
  return Astro.redirect('/select-location');
}

interface Location {
  _id: string;
  name: string;
}

interface Store {
  _id: string;
  name: string;
  locationId: Location | string;
  isOpen?: boolean;
}

let stores: Store[] = [];
let locationName = '';

try {
  const [loc, storeList] = await Promise.all([
    api.get<Location>(`/api/locations/${locationId}`),
    api.get<Store[]>(`/api/stores/by-location/${locationId}`),
  ]);
  locationName = loc.name;
  stores = storeList;
} catch {
  // handled below
}
---

<CustomerLayout title="Select Store">
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <div class="text-center">
      <h1 class="text-2xl font-bold tracking-tight">Stores in {locationName}</h1>
      <p class="text-sm text-muted-foreground">
        Select a store to start shopping
      </p>
    </div>

    <div class="text-center">
      <a href="/select-location" class="text-sm text-primary hover:underline">
        &larr; Change location
      </a>
    </div>

    {
      stores.length === 0 ? (
        <Empty className="py-12">
          <EmptyHeader>
            <EmptyMedia variant="icon">
              <StoreIcon />
            </EmptyMedia>
            <EmptyDescription>
              No stores available at this location yet.
            </EmptyDescription>
          </EmptyHeader>
        </Empty>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {stores.map((store) => {
            const isClosed = store.isOpen === false;
            return (
              <a
                href={isClosed ? undefined : `/shop/${store._id}`}
                class:list={['group', isClosed && 'cursor-not-allowed']}
                aria-disabled={isClosed}
                onclick={isClosed ? 'event.preventDefault()' : undefined}
              >
                <Card
                  className={
                    isClosed
                      ? 'border-border opacity-60 transition-all'
                      : 'transition-all group-hover:border-operational group-hover:shadow-md'
                  }
                >
                  <CardContent className="flex items-center gap-3">
                    <div class:list={[
                      'flex size-10 items-center justify-center rounded-full',
                      isClosed ? 'bg-muted text-muted-foreground' : 'bg-operational-subtle text-operational',
                    ]}>
                      <StoreIcon className="size-5" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class:list={[
                        'text-lg font-semibold',
                        isClosed ? 'text-muted-foreground' : 'group-hover:text-operational',
                      ]}>{store.name}</p>
                      {isClosed && (
                        <p class="mt-0.5 text-xs font-medium text-destructive">Closed for the day</p>
                      )}
                    </div>
                    {isClosed && <Badge variant="error">Closed</Badge>}
                  </CardContent>
                </Card>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</CustomerLayout>
