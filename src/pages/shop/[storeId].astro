---
import { ShopView } from '../../components/app/ShopView';
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import { createApiClient } from '../../lib/api';

const { storeId } = Astro.params;
const token = Astro.cookies.get('agora_token')?.value ?? '';
const api = createApiClient(token);

interface Store {
  _id: string;
  name: string;
  isOpen: boolean;
  isMaintenance: boolean;
  bannerUpdatedAt?: string | null;
}

let storeName = 'Store';
let storeIsOpen = true;
let storeIsMaintenance = false;
let bannerUrl: string | undefined;
try {
  const store = await api.get<Store>(`/api/stores/${storeId}`);
  storeName = store.name;
  storeIsOpen = store.isOpen ?? true;
  storeIsMaintenance = store.isMaintenance ?? false;
  if (store.bannerUpdatedAt) {
    bannerUrl = `/api/stores/${storeId}/banner?v=${new Date(store.bannerUpdatedAt).getTime()}`;
  }
} catch {
  // handled in component
}
---

<CustomerLayout title={storeName}>
  <ShopView storeId={storeId!} storeName={storeName} initialIsOpen={storeIsOpen} initialIsMaintenance={storeIsMaintenance} bannerUrl={bannerUrl} client:load />
</CustomerLayout>
