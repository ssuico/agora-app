---
import AuthShell from '../components/app/AuthShell.astro';
import { ForgotPasswordForm } from '../components/app/ForgotPasswordForm';
import { decodeJWT } from '../lib/jwt';

const token = Astro.cookies.get('agora_token')?.value;
if (token) {
  const payload = decodeJWT(token);
  if (payload) {
    const isExpired = payload.exp != null && payload.exp * 1000 < Date.now();
    if (!isExpired) return Astro.redirect('/');
  }
  Astro.cookies.delete('agora_token', { path: '/' });
}
---

<AuthShell
  title="Reset Password"
  kicker="Existing account"
  headline="Set a new password after a code reaches your inbox."
  lede="Email reset stays off until confirmation codes are turned on. An admin can still reset a staff password."
  notices={[
    { label: 'Your email', detail: 'The address must already have an account.' },
    { label: '6-digit code', detail: 'It expires 10 minutes after it is sent.' },
    { label: 'Then sign in', detail: 'The old password stops working.' },
  ]}
>
  <div class="flex w-full max-w-md flex-col gap-4 self-center">
    <ForgotPasswordForm client:load />
    <div class="auth-credit">
      <p>Powered by Channel Precision Devs</p>
    </div>
  </div>
</AuthShell>
