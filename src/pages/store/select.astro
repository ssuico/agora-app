---
import AppLayout from '../../layouts/AppLayout.astro';
import { decodeJWT } from '../../lib/jwt';
import { createApiClient } from '../../lib/api';
import { Button } from '../../components/ui/button';
import { Card, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '../../components/ui/empty';
import { TriangleAlert } from 'lucide-react';

const token = Astro.cookies.get('agora_token')?.value ?? '';
const payload = decodeJWT(token);
const storeIds = payload?.storeIds ?? [];

const noStores = storeIds.length === 0;

if (storeIds.length === 1) {
  return Astro.redirect(`/store/${storeIds[0]}`);
}

const api = createApiClient(token);

interface Store {
  _id: string;
  name: string;
  locationId?: { _id: string; name: string };
}

let stores: Store[] = [];
if (!noStores) {
  try {
    const all = await api.get<Store[]>('/api/stores');
    stores = all.filter((s) => storeIds.includes(s._id));
  } catch {
    // handled below
  }
}
---

<AppLayout title="Select Store">
  <div class="mx-auto flex max-w-2xl flex-col gap-6">
    {noStores ? (
      <Empty className="py-12">
        <EmptyHeader>
          <EmptyMedia variant="icon">
            <TriangleAlert />
          </EmptyMedia>
          <EmptyTitle role="heading" aria-level={1} className="text-2xl font-bold">No Stores Assigned</EmptyTitle>
          <EmptyDescription>
            Your account doesn't have any stores assigned yet. Please contact an administrator to get assigned to a store.
          </EmptyDescription>
        </EmptyHeader>
        <EmptyContent>
          <form method="POST" action="/api/auth/logout">
            <Button type="submit">Sign out</Button>
          </form>
        </EmptyContent>
      </Empty>
    ) : (
      <>
        <div class="text-center">
          <h1 class="text-2xl font-bold tracking-tight">Select a Store</h1>
          <p class="text-sm text-muted-foreground">
            You are assigned to multiple stores. Choose one to manage.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            stores.map((store) => (
              <a href={`/store/${store._id}`} class="group">
                <Card className="transition-colors group-hover:bg-accent">
                  <CardHeader>
                    <CardTitle className="text-lg">{store.name}</CardTitle>
                    {store.locationId && typeof store.locationId === 'object' && (
                      <CardDescription>{store.locationId.name}</CardDescription>
                    )}
                  </CardHeader>
                </Card>
              </a>
            ))
          }
        </div>
      </>
    )}
  </div>
</AppLayout>
