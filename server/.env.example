# Signup confirmation and password-reset emails.
# Set EMAIL_VERIFICATION_ENABLED=true to send signup and password-reset codes.
# Leave it false or omit it to create customer accounts immediately.
# Run "pnpm mail:verify" in server/ before enabling. SendGrid IP Access Management must allow this server's outbound IP.
# SMTP_PASS is the SendGrid API key (needs the "Mail Send" permission). Never commit it; keep it only in server/.env or the host's env vars.
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM_ADDRESS=agora@outdoorequipped.com
SMTP_FROM_NAME=Agora POS
SMTP_REPLY_TO=agora@outdoorequipped.com
