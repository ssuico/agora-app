# === Development (Astro dev server + separate Express server) ===
# Used by Astro proxy routes to forward API calls to Express
PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# === Production (single Express server serves everything) ===
# These are not needed in production since Express handles API directly.
# On Railway, just set environment variables in the server/.env section.

# === API server (server/.env) — signup confirmation and password reset ===
# Restart the API after changing these.
# Set EMAIL_VERIFICATION_ENABLED=true to require a signup code and allow password reset by email.
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM_ADDRESS=agora@outdoorequipped.com
SMTP_FROM_NAME=Agora POS
SMTP_REPLY_TO=agora@outdoorequipped.com

